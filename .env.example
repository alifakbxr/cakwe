# Google Gemini API Key (get free key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama settings (optional fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# JobsPipe API Key (optional multi-source aggregator)
JOBSPIPE_API_KEY=your_jobspipe_api_key_here
JOBSPIPE_MAX_PER_FETCH=5

# App Settings
DATABASE_URL=sqlite:///../data/db/radar.sqlite3
POLL_INTERVAL_HOURS=5
