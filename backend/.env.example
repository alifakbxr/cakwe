# Google AI Studio API Key (dapatkan gratis di aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama settings (default local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# JobsPipe API Key (opsional untuk memperluas agregator multi-sumber)
JOBSPIPE_API_KEY=your_jobspipe_api_key_here
JOBSPIPE_MAX_PER_FETCH=5

# App settings
DATABASE_URL=sqlite:///../data/db/radar.sqlite3
POLL_INTERVAL_MINUTES=60
